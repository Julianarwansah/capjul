{
  "name": "capjul",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5173 NODE_ENV=development concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@radix-ui/react-context-menu": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-slider": "^1.6.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "postcss": "^8.5.29",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "wavesurfer.js": "^8.0.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.capjul.editor",
    "productName": "CapJul",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^8.0.5"
  }
}
